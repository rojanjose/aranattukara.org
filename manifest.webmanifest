---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": "Aranattukara · അരണാട്ടുകര",
  "short_name": "Aranattukara",
  "start_url": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#FAF7F0",
  "theme_color": "#2F5D3A",
  "icons": [
    { "src": "{{ '/assets/img/favicon.svg' | relative_url }}", "sizes": "any", "type": "image/svg+xml" },
    { "src": "{{ '/assets/img/logo-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/img/logo-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ]
}
